# Bu dosyayı .env olarak kopyala ve doldur. .env'i kimseyle paylaşma.

# --- Claude ---
LLM_BACKEND=auto              # auto: önce bilgisayardaki Claude Code, yoksa API anahtarı
# CLAUDE_CODE_PATH=           # bulunamazsa claude.exe yolunu elle ver
ANTHROPIC_API_KEY=            # sadece Claude Code yoksa gerekir

# --- Görsel ---
IMAGE_PROVIDER=claude-svg     # claude-svg (anahtarsız) | openai | placeholder
IMAGE_WORKERS=3               # aynı anda çizilen görsel sayısı
OPENAI_API_KEY=               # sadece IMAGE_PROVIDER=openai ise
IMAGE_MODEL=gpt-image-1
# IMAGE_STYLE=flat 2D cartoon illustration, ...

# --- Ses (edge-tts, ücretsiz) ---
TTS_DEFAULT_VOICE=female      # female (Emel) | male (Ahmet)

# --- Yayın ---
PLATFORMS=youtube,tiktok,instagram
SAU_ACCOUNT=main
YOUTUBE_VISIBILITY=public     # ilk denemelerde private yap
YOUTUBE_MADE_FOR_KIDS=0      # 1 = içerik çocuklara özel (YouTube yasal beyanı)

# --- İstatistik (YouTube Data API, sadece okuma) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=           # UC... ile başlayan kanal kimliği

# --- Planlama ---
PLAN_AHEAD_DAYS=7
VIDEOS_PER_DAY=1

# Anlatıcı karakter (videoda konuşan robot rozeti). Boş bırakılırsa kapalı.
NARRATOR_NAME=Cuma Robot

# Yüksek kalite anlatıcı (Gemini Omni Flash, ücretli). Panelden de girilebilir.
GEMINI_API_KEY=
